[Desktop Entry]
Type=Application
Name=Agent Minibar
GenericName=AI usage monitor
Comment=AI tools usage limits, resets and spend in the system tray
Exec=agent-minibar
Icon=agent-minibar
Terminal=false
Categories=Utility;
Keywords=codex;claude;cursor;usage;limits;tray;
StartupWMClass=io.github.trumanfan.AgentMinibar
StartupNotify=false
Actions=Toggle;

[Desktop Action Toggle]
Name=Show or hide the popup
Exec=agent-minibar --toggle
